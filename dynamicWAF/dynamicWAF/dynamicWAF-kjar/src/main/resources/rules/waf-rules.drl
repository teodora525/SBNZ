package rules;

import com.waf.dynamicWAF.model.RequestEvent;
import com.waf.dynamicWAF.model.ThreatAlert;
import com.waf.dynamicWAF.model.ThreatScore;
import com.waf.dynamicWAF.model.WafConfiguration;
import com.waf.dynamicWAF.model.IpBan;

// ---------------------------------------------------------
// NIVO 1: DETEKCIJA (Oslanjamo se na Payload)
// ---------------------------------------------------------

rule "Detekcija SQL Injection pokušaja"
when
    // Trazimo zahtev koji ima payload i sadrzi tipicne SQL injekcije
    $req : RequestEvent(payload != null, payload.toUpperCase() contains "UNION SELECT" || payload.toUpperCase() contains "OR '1'='1")
then
    System.out.println("LOG NIVO 1: Sumnjiv SQL kod detektovan sa IP: " + $req.getIpAddress());

    // DISPATCH: Ubacujemo novi događaj u memoriju (OVO JE POČETAK FORWARD CHAINING-a)
    insert(new ThreatAlert($req.getIpAddress(), "POTENTIAL_SQL_INJECTION"));
end

rule "Detekcija XSS pokušaja"
when
    $req : RequestEvent(payload != null, payload.toLowerCase() contains "<script>")
then
    System.out.println("LOG NIVO 1: Sumnjiv XSS kod detektovan sa IP: " + $req.getIpAddress());
    insert(new ThreatAlert($req.getIpAddress(), "POTENTIAL_XSS"));
end

// ---------------------------------------------------------
// NIVO 2: FORWARD CHAINING (Grupisanje pretnji)
// ---------------------------------------------------------

rule "Grupisanje pretnji u Malicious Payload"
when
    // Ako je Drools prethodno ubacio bilo koji od ova dva alarma, hvatamo ga
    $alert : ThreatAlert(alertType == "POTENTIAL_SQL_INJECTION" || alertType == "POTENTIAL_XSS")
then
    System.out.println("LOG NIVO 2: Apstrahovanje pretnje u MALICIOUS_PAYLOAD_DETECTED za IP: " + $alert.getSourceIp());

    // Opet dispatch (lanac se nastavlja)
    insert(new ThreatAlert($alert.getSourceIp(), "MALICIOUS_PAYLOAD_DETECTED"));
end

// ---------------------------------------------------------
// NIVO 3: REAKCIJA NA APSTRAHOVANU PRETNJU
// ---------------------------------------------------------

rule "Reakcija na Malicious Payload"
when
    // Kada dodjemo do Malicious Payload-a, trazimo taj originalni zahtev da ga blokiramo i score da ga povecamo
    $alert : ThreatAlert(alertType == "MALICIOUS_PAYLOAD_DETECTED", $ip : sourceIp)
    // ISPRAVLJENO: Koristimo "blocked == false" umesto "isBlocked"
    $req : RequestEvent(ipAddress == $ip, blocked == false)
    $score : ThreatScore(ipAddress == $ip)
then
    // Blokiramo zahtev
    modify($req) {
        setBlocked(true),
        setBlockReason("Malicious Payload Detected")
    }
    // Dodajemo kaznene poene
    modify($score) {
        increment(50)
    }
    System.out.println("LOG NIVO 3 (AKCIJA): Zahtev blokiran! Threat Score za " + $ip + " je skočio na: " + $score.getScore());
end

// ---------------------------------------------------------
// NIVO 4: KONAČNA ODLUKA BAZIRANA NA KONTEKSTU C[K]
// ---------------------------------------------------------

rule "Banovanje IP adrese zbog prekoračenja poena (Context Aware)"
when
    // Izvlačimo WafConfiguration koji smo ubacili prilikom paljenja aplikacije
    $config : WafConfiguration($maxScore : maxAllowedScore)

    // Proveravamo da li je ThreatScore prebacio limit za TRENUTNI kontekst
    $score : ThreatScore($ip : ipAddress, score > $maxScore)

    // Osiguravamo se da ga nismo vec banovali
    not IpBan(ipAddress == $ip)
then
    System.out.println("LOG NIVO 4 (ALARM): Threat Score (" + $score.getScore() + ") prešao limit (" + $maxScore + ")! Banujem IP: " + $ip);

    // Finalna akcija - ubacivanje Bana
    insert(new IpBan($ip, "Prekoračen Threat Score limit u kontekstu: " + $config.getCurrentContext()));
end

// ---------------------------------------------------------
// NIVO 5: CEP (Complex Event Processing) - Ponašanje kroz vreme
// ---------------------------------------------------------

rule "CEP - Detekcija Brute Force napada"
when
    // 1. Uzimamo limit iz trenutne WAF konfiguracije (C[K])
    $config : WafConfiguration($limit : maxFailedLoginsPerMinute)

    // 2. Fiksiramo IP adresu sa trenutnog zahteva
    $req1 : RequestEvent(httpMethod == "POST", uri == "/login", $ip : ipAddress)

    // 3. CEP MAGIJA: Brojimo koliko je ovakvih zahteva sa te IP adrese stiglo u poslednjih 1 minut
    Number(intValue >= $limit) from accumulate(
        $req2 : RequestEvent(httpMethod == "POST", uri == "/login", ipAddress == $ip) over window:time(1m),
        count($req2)
    )

    // 4. Osiguravamo se da nismo već banovali ovu IP adresu
    not IpBan(ipAddress == $ip)
then
    System.out.println("LOG CEP: Detektovan BRUTE FORCE napad sa IP: " + $ip + ". Premašen limit od " + $limit + " pokušaja!");

    // Beležimo pretnju
    insert(new ThreatAlert($ip, "BRUTE_FORCE_ATTACK"));

    // Automatski Ban
    insert(new IpBan($ip, "Brute Force (> " + $limit + " login pokušaja) u kontekstu: " + $config.getCurrentContext()));
end